# Copy to .env or export in your shell. NEVER commit real values.
# See CLAUDE.md "How to rediscover the environment" for the az commands
# that produce each of these.

# Your Foundry resource endpoint (services.ai.azure.com and openai.azure.com both work)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.services.ai.azure.com

# The deployment name of your realtime model (case-sensitive)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-realtime-2.1

# Entra access token, pre-fetched because of the multi-tenant gotcha (CLAUDE.md #1).
# Expires in ~60-90 min. If unset, scripts fall back to DefaultAzureCredential.
# AZURE_TOKEN=$(az account get-access-token --subscription <sub-id> --resource https://ai.azure.com --query accessToken -o tsv)

# Port for talk-server.js (default 8787)
# PORT=8787
