[Unit]
Description=Jarvis voice private preview (isolated; not production)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/localadmin/homelab/realtime-ai-voice-live
ExecStart=/home/localadmin/.local/bin/node src/live/server.js
Environment="PATH=/home/localadmin/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment=PORT=8789
Environment=HERMES_VOICE_PROFILE=voice-live-preview
Environment=HINDSIGHT_CONFIG_PATH=/home/localadmin/.hermes/profiles/voice-live-preview/hindsight/config.json
Environment=VOICE_MEMORY_MODELS=v-profile-and-standards,personal,work
Environment=VOICE_STATE_PATH=/home/localadmin/voice-implementation-evidence-2026-09-21/personal-preview-state.sqlite
Environment=VOICE_QUALIFICATION=0
Environment=AZURE_SUBSCRIPTION_ID=e1e5b742-d76b-4ce5-97d3-8d820bb33904
Environment=AZURE_OPENAI_ENDPOINT=https://ai103-resource-ruffin.openai.azure.com
Environment=AZURE_OPENAI_DEPLOYMENT_NAME=jarvis-live-qualification
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
