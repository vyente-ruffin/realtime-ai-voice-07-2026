# Fill in your Azure resource and subscription. Existing az login; no cloud keys.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=YOUR-GPT-LIVE-DEPLOYMENT
AZURE_SUBSCRIPTION_ID=YOUR-SUBSCRIPTION-ID
PORT=8789
HOST=127.0.0.1
# Main Hermes profile's API server; the key is read from API_SERVER_KEY in ~/.hermes/.env.
HERMES_API_URL=http://10.69.3.175:8642
# Reasoning effort for voice tasks; leave empty for the Hermes default.
VOICE_REASONING_EFFORT=medium
HINDSIGHT_CONFIG_PATH=/home/localadmin/.hermes/hindsight/config.json
VOICE_MEMORY_MODELS=jarvis-voice-profile,jarvis-voice-preferences,jarvis-voice-current
# Use a distinct private state file for each memory bank.
VOICE_STATE_PATH=/home/localadmin/homelab/realtime-ai-voice/logs/live-personal/state.sqlite
# Enable only with an isolated profile, synthetic bank, and separate state file.
VOICE_QUALIFICATION=0
